# Install (root):  cp ops/systemd/netsentinel-orchestrator.service /etc/systemd/system/ && systemctl daemon-reload
#                  systemctl enable --now netsentinel-orchestrator
[Unit]
Description=NetSentinel Security Orchestrator
After=network.target postgresql.service wall-proxy@netsentinel.service
Wants=wall-proxy@netsentinel.service

[Service]
Type=simple
User=linuxuser
SupplementaryGroups=wall-netsentinel-clients
WorkingDirectory=/home/linuxuser/netsentinel
ExecStart=/home/linuxuser/netsentinel/.venv/bin/netsentinel agent orchestrator
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/linuxuser/netsentinel

[Install]
WantedBy=multi-user.target
