# Install (root):  cp ops/systemd/netsentinel-risk.service /etc/systemd/system/ && systemctl daemon-reload
#                  systemctl enable --now netsentinel-risk
[Unit]
Description=NetSentinel Risk Assessment Agent
After=network.target postgresql.service wall-proxy@netsentinel.service
Wants=wall-proxy@netsentinel.service

[Service]
Type=simple
User=linuxuser
SupplementaryGroups=wall-netsentinel-clients
WorkingDirectory=/home/linuxuser/netsentinel
ExecStart=/home/linuxuser/netsentinel/.venv/bin/netsentinel agent risk
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/linuxuser/netsentinel

[Install]
WantedBy=multi-user.target
